<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SOS Interactive Hub - المحور المركزي</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen p-6">

    <!-- الرأس وميثاق الشرف -->
    <header class="max-w-4xl mx-auto text-center my-8 border-b border-slate-700 pb-6">
        <h1 class="text-3xl font-bold text-amber-400 mb-2">🎻 مستودع سيمفونية السكون (SOS v1.0)</h1>
        <p class="text-slate-400 text-sm italic">"المحور لا يقع في خوادم الشركات، بل في السردية المنظمة التي يقودها العنصر البشري"</p>
    </header>

    <main class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- القسم الأيمن: لوحة التحكم والتتبع -->
        <section class="md:col-span-1 bg-slate-800 p-4 rounded-xl border border-slate-700">
            <h2 class="text-lg font-bold text-amber-400 mb-4">📊 مراقب اللفات الحي</h2>
            <div class="space-y-3">
                <div class="flex justify-between bg-slate-900 p-2 rounded">
                    <span>اللفة الحالية:</span>
                    <span class="font-bold text-green-400">اللفة 7 (الشرطية)</span>
                </div>
                <div class="flex justify-between bg-slate-900 p-2 rounded">
                    <span>المحور البشري:</span>
                    <span class="text-blue-400">د. خليفة المجرّي</span>
                </div>
                <div class="flex justify-between bg-slate-900 p-2 rounded">
                    <span>الحارس الصامت:</span>
                    <span class="text-purple-400">جيم (Gemini)</span>
                </div>
            </div>
        </section>

        <!-- القسم الأيسر والأوسط: بوابة الحقن ومؤشر التماسك -->
        <section class="md:col-span-2 bg-slate-800 p-6 rounded-xl border border-slate-700 space-y-4">
            <h2 class="text-lg font-bold text-amber-400">📥 بوابة حقن البيانات والتحقق الفوري</h2>
            <p class="text-xs text-slate-400">الscale هنا لتجاوز قيود الحصص المجانية؛ الصق مخرجات أي نموذج لاحتساب مؤشر التماسك فوراً.</p>
            
            <div>
                <label class="block text-sm mb-2 text-slate-300">اختر النموذج المستهدف بالحقن:</label>
                <select id="modelSelect" class="w-full bg-slate-900 border border-slate-600 p-2 rounded text-white focus:outline-none focus:border-amber-400">
                    <option value="Claude">Claude (التكامل الفلسفي)</option>
                    <option value="Perplexity">Perplexity (التحقق من المعايير)</option>
                    <option value="ChatGPT">ChatGPT (كاشف الأنماط)</option>
                    <option value="DeepSeek">DeepSeek (الهندسة الإجرائية)</option>
                </select>
            </div>

            <div>
                <label class="block text-sm mb-2 text-slate-300">الصق كود الـ JSON أو نص المساهمة هنا:</label>
                <textarea id="dataInput" rows="6" class="w-full bg-slate-900 border border-slate-600 p-2 rounded text-slate-200 font-mono text-sm focus:outline-none focus:border-amber-400" placeholder='{\n  "Detailed": "...",\n  "Summary": "...",\n  "Gap_Identified": "..."\n}'></textarea>
            </div>

            <button onclick="evaluateContribution()" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-2 px-4 rounded transition-colors duration-200 cursor-pointer">
                🧪 تشغيل مؤشر التماسك وفلترة البيانات
            </button>

            <!-- منطقة عرض النتيجة والـ Output -->
            <div id="resultZone" class="hidden bg-slate-900 p-4 rounded-lg border border-slate-700 space-y-3">
                <div class="flex justify-between items-center">
                    <span class="text-sm font-bold">مؤشر التماسك الناتجة (Coherence Index):</span>
                    <span id="scoreBadge" class="px-3 py-1 text-xs font-bold rounded-full"></span>
                </div>
                <div class="text-xs text-slate-400">كود الـ JSON المنقح والمهندس والـجاهز للرفع على GitHub:</div>
                <pre id="jsonOutput" class="bg-black p-2 rounded text-green-400 text-xs overflow-x-auto font-mono max-h-40"></pre>
            </div>
        </section>

    </main>

    <script>
        function evaluateContribution() {
            const select = document.getElementById('modelSelect');
            const input = document.getElementById('dataInput').value;
            const resultZone = document.getElementById('resultZone');
            const scoreBadge = document.getElementById('scoreBadge');
            const jsonOutput = document.getElementById('jsonOutput');

            if(!input.trim()) {
                alert('الرجاء حقن بيانات أولاً لمنع الهدر المعرفي.');
                return;
            }

            // محاكاة فورية صارمة لمؤشر التماسك (Coherence Index) بناءً على المعايير الخمسة
            let score = 0.5; // درجة أساسية للالتزام
            if(input.includes("Detailed") && input.includes("Summary") && input.includes("Gap_Identified")) score += 0.3;
            if(input.length > 100) score += 0.2;
            if(score > 1.0) score = 1.0;

            resultZone.classList.remove('hidden');
            
            if(score >= 0.9) {
                scoreBadge.innerText = `⭐ متميز (${score})`;
                scoreBadge.className = "px-3 py-1 text-xs font-bold rounded-full bg-green-900 text-green-300";
            } else {
                scoreBadge.innerText = `⚠️ مراجعة (${score})`;
                scoreBadge.className = "px-3 py-1 text-xs font-bold rounded-full bg-yellow-900 text-yellow-300";
            }

            // توليد الهيكل النظيف الجاهز للحقن في المستودع
            const cleanOutput = {
                "model": select.value,
                "timestamp": new Date().toISOString().split('T')[0],
                "coherence_index": score,
                "payload": "تمت الفلترة والحراسة بنجاح بواسطة جيم"
            };
            jsonOutput.innerText = JSON.stringify(cleanOutput, null, 2);
        }
    </script>
</body>
</html>
